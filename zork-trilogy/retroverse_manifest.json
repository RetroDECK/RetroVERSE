{
  "schema_version": "1",
  "min_client_schema": "1",
  "id": "zork-trilogy",
  "class": "data",
  "name": "Zork Trilogy",
  "description": "The full Zork Trilogy is a collection of three legendary classic interactive fiction games for the Z-machine.",
  "version": "1.0.0",
  "tags": [
    "game",
    "rom"
  ],
  "requires": [
    "component:retroarch",
    "component:gargoyle"
  ],
  "artwork": "artwork/thumb.png",
  "files": [
    {
      "source": "zork1.z3",
      "destination": "$roms_path/zmachine/zork1.z3",
      "policy": "replace"
    },
    {
      "source": "zork2.z3",
      "destination": "$roms_path/zmachine/zork2.z3",
      "policy": "replace"
    },
    {
      "source": "zork3.z3",
      "destination": "$roms_path/zmachine/zork3.z3",
      "policy": "replace"
    },
    {
      "source": "docs/LICENSE",
      "destination": "$roms_path/zmachine/zork_docs/LICENSE",
      "policy": "replace"
    }
  ]
}
