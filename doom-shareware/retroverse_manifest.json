{
  "schema_version": "1",
  "id": "doom-shareware",
  "min_client_schema": "1",
  "class": "data",
  "name": "DOOM Shareware",
  "description": "DOOM Shareware v1.9 featuring the original classic episode: 'Knee-Deep in the Dead'.",
  "version": "1.0.0",
  "tags": [
    "game",
    "rom"
  ],
  "requires": [
    "component:uzdoom"
  ],
  "artwork": "artwork/thumb.png",
  "files": [
    {
      "source": "DOOM1.WAD",
      "destination": "$roms_path/doom/DOOM1.WAD",
      "policy": "replace"
    },
    {
      "source": "docs/DMFAQ66A.TXT",
      "destination": "$roms_path/doom/doom_shareware_docs/DMFAQ66A.TXT",
      "policy": "replace"
    },
    {
      "source": "docs/DMFAQ66B.TXT",
      "destination": "$roms_path/doom/doom_shareware_docs/DMFAQ66B.TXT",
      "policy": "replace"
    },
    {
      "source": "docs/DMFAQ66C.TXT",
      "destination": "$roms_path/doom/doom_shareware_docs/DMFAQ66C.TXT",
      "policy": "replace"
    },
    {
      "source": "docs/DMFAQ66D.TXT",
      "destination": "$roms_path/doom/doom_shareware_docs/DMFAQ66D.TXT",
      "policy": "replace"
    },
    {
      "source": "docs/HELPME.TXT",
      "destination": "$roms_path/doom/doom_shareware_docs/HELPME.TXT",
      "policy": "replace"
    },
    {
      "source": "docs/README.TXT",
      "destination": "$roms_path/doom/doom_shareware_docs/README.TXT",
      "policy": "replace"
    }
  ]
}
