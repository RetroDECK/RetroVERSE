{
  "schema_version": "1",
  "min_client_schema": "1",
  "id": "freedoom",
  "class": "data",
  "name": "FreeDOOM",
  "description": "Freedoom is a free, open-source game for UZDoom, compatible with many custom DOOM levels, music, graphics and mods.",
  "version": "1.0.1",
  "tags": [
    "game",
    "rom"
  ],
  "requires": [
    "component:uzdoom"
  ],
  "artwork": "artwork/thumb.png",
  "files": [
    {
      "source": "freedm.wad",
      "destination": "$roms_path/doom/freedm.wad",
      "policy": "replace"
    },
    {
      "source": "freedoom1.wad",
      "destination": "$roms_path/doom/freedoom1.wad",
      "policy": "replace"
    },
    {
      "source": "freedoom2.wad",
      "destination": "$roms_path/doom/freedoom2.wad",
      "policy": "replace"
    },
    {
      "source": "docs/COPYING.txt",
      "destination": "$roms_path/doom/freedoom_docs/COPYING.txt",
      "policy": "replace"
    },
    {
      "source": "docs/CREDITS.txt",
      "destination": "$roms_path/doom/freedoom_docs/CREDITS.txt",
      "policy": "replace"
    },
    {
      "source": "docs/CREDITS-MUSIC.txt",
      "destination": "$roms_path/doom/freedoom_docs/CREDITS-MUSIC.txt",
      "policy": "replace"
    }
  ]
}
