{
  "rtdink": {
    "name": "RTDink",
    "core_framework_compatibility": "1",
    "component_version": "1.0.0",
    "schema_version": "1",
    "min_client_schema": "1",
    "id": "rtdink",
    "class": "data",
    "capabilities": [
      "reset",
      "open"
    ],
    "url_rdwiki": "https://retrodeck.readthedocs.io/en/latest/wiki_engine_guides/mudlet/mudlet-guide/",
    "url_webpage": "https://www.dinknetwork.com/",
    "url_donation_purchase": "https://www.gog.com/en/game/dink_smallwood_hd",
    "url_source": "https://github.com/SethRobinson/RTDink",
    "component_type": "Engine",
    "description": "RTDink Engine for Dink Smallwood HD and dmods.",
    "system_friendly_name": "Dink Smallwood HD",
    "system": "dink",
    "artwork": "artwork/thumb.png",
    "tags": [
      "engine",
      "game"
    ],
    "es_de_config": {
      "es_find_rules": {
        "emulators": [
          {
            "name": "RTDINK",
            "description": "RTDink - Dink Smallwood HD Engine",
            "rules": [
              {
                "type": "staticpath",
                "entries": [
                  "%COMPONENT_PATH%/component_launcher.sh"
                ]
              }
            ]
          }
        ]
      },
      "es_systems": [
        {
          "name": "dink",
          "fullname": "Dink Smallwood HD",
          "path": "%ROMPATH%/dink",
          "extension": ".dink",
          "commands": [
            {
              "label": "RTDink (Standalone)",
              "command": "%EMULATOR_RTDINK% %ROM%"
            }
          ],
          "platform": "pc, pcwindows",
          "theme": "dink"
        }
      ]
    }
  }
}